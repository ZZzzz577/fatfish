# QQ 开放平台机器人凭证（新版使用 AppID + AppSecret 换取 access_token）
APP_ID=
APP_SECRET=

# deep agent 使用的 OpenAI 兼容模型
OPENAI_API_KEY=
# 官方 OpenAI 可留空；DeepSeek/通义/智谱等填对应地址，如 https://api.deepseek.com/v1
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
# 0 更像客服，0.7~0.9 更像群友
OPENAI_TEMPERATURE=0.7
# 单次模型调用超时（毫秒）
OPENAI_TIMEOUT_MS=60000

# 每个群/私聊保留最近多少条聊天作为上下文
HISTORY_LIMIT=20
# 单条回复最大字数，超出会按句子拆成多条发送
REPLY_MAX_CHARS=600
# 不 @ 但提到这些词也会接话，逗号分隔；留空则只响应 @
WAKE_WORDS=大肥鱼,肥鱼,胖鱼,肥鱼鱼,fatfish
# 被叫到之后多久内的提问都当作在问它（毫秒），0 表示关闭
FOLLOW_UP_MS=90000
# 聊天记录落盘路径，重启后用它恢复上下文
HISTORY_DB=data/history.sqlite
# 每个会话最多保留多少条落盘记录
HISTORY_KEEP=500
# 每次回复最多带上多少条长期记忆
MEMORY_LIMIT=20
# 每个会话最多保存多少条长期记忆
MEMORY_KEEP=200
# 联网搜索/读链接（用 DeepSeek 的 Search/Fetch 接口），off 关闭
WEB_TOOLS=on
# 可选：单独指定搜索接口地址和 key，默认复用 OPENAI_BASE_URL / OPENAI_API_KEY
SEARCH_BASE_URL=
SEARCH_API_KEY=
# 让鱼知道现在几点
TIMEZONE=Asia/Shanghai
